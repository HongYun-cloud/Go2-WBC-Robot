<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_robot</name>
  <version>0.1.0</version>
  <description>
    Go2 quadruped whole-body control: MuJoCo simulation + MPC (async low-rate) +
    WBC (real-time high-rate) under ROS 2.
  </description>
  <maintainer email="hong@todo.todo">hong</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <!-- Pinocchio 来自 ROS Humble 的系统安装, 非 ament 包, 通过 CMake find_package 使用 -->
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
